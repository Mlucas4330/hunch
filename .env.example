DATABASE_URL=postgres://postgres:postgres@localhost:5432/hunch
AUTH_SECRET=
# Per-environment origins. Never copy these two into a deploy -- a localhost value there breaks
# Google sign in and points the embed snippet at the visitor's own machine. See README > Deployment.
# AUTH_URL overrides the request origin whenever it is set, so leave it empty in production and let
# AUTH_TRUST_HOST=true derive the origin from the proxy instead.
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional second sign in path, for buyers on Microsoft 365. The button and the provider appear only
# when both the id and the secret are set. See docs/security.md.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
AUTH_TRUST_HOST=
SCREENSHOT_DIR=./.screenshots
BRAND_DIR=./.brand
BROWSER_URL=
CRON_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ALLOW_CREDENTIALS_LOGIN=
REDIS_URL=
CSP_ENFORCE=
PUPPETEER_ALLOW_NO_SANDBOX=
ANTHROPIC_API_KEY=
E2E_FIXTURES=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
