DATABASE_URL=postgres://postgres:postgres@localhost:5432/hunch
AUTH_SECRET=
# Per-environment origins. Never copy these two into a deploy -- a localhost value there breaks
# Google sign in and points shared report links at the visitor's own machine. See README > Deployment.
#
# **AUTH_URL must hold this environment's own origin, in production too.** It is the only thing that
# decides where Auth.js sends a visitor: with it unset, the origin comes from the request Next
# received, which behind a proxy is the container -- so every redirect lands on localhost:<PORT>
# rather than on the site. AUTH_TRUST_HOST does not fix that; it decides whether the request is
# served at all, not what URL is built.
#
# **And an empty value is worse than an unset one.** Auth.js resolves trust as
# `AUTH_URL ?? AUTH_TRUST_HOST ?? ...`, and `??` only falls through on null or undefined -- an empty
# string does not, so it wins the chain, resolves falsy, and every auth request answers UntrustedHost
# no matter what AUTH_TRUST_HOST says. Set the real origin or remove the variable; never blank it.
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_TRUST_HOST=true

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional second sign in path. The button and the provider appear only when both are set.
# The OAuth app needs the `user:email` scope: GitHub emits no verified-email claim, so the address is
# verified by calling its API, and without that scope the call answers 403 and every login is refused.
# See docs/security.md.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

SCREENSHOT_DIR=./.screenshots
BROWSER_URL=
CRON_SECRET=

# Promotes the matching row to admin at sign in, and never demotes. Removing it revokes nothing --
# that is `update users set role = 'user'`. See docs/invariants.md.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Development only: credentialsLoginAllowed() refuses in production whatever this says.
ALLOW_CREDENTIALS_LOGIN=

# Rate limiting AND the job queue. Required: without it previews render inline and **every** analysis
# answers 503, not just an anonymous one. See docs/development.md and docs/invariants.md.
REDIS_URL=redis://localhost:6379

CSP_ENFORCE=
PUPPETEER_ALLOW_NO_SANDBOX=
ANTHROPIC_API_KEY=
E2E_FIXTURES=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One price id per credit pack. **These are the only thing that decides how many credits a payment
# buys** -- Stripe metadata is dashboard-editable and is deliberately never read, so a pack is worth
# what CREDIT_PACKS says it is worth. An unset id makes that pack refuse checkout rather than sell
# nothing. The amount each one charges must match the price printed in the dictionary: they are two
# places holding one number, and Stripe is not asked at render time.
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_TRIO=

# Mercado Pago. The access token is the private credential and the public key is what the Payment
# Brick is initialised with in the browser -- test and production credentials come in pairs and must
# never be mixed. The webhook secret is the one shown under "Suas integracoes" for the notification
# URL, and without it every delivery is refused rather than trusted.
#
# How many credits a payment buys comes from CREDIT_PACKS.amountBrl, never from what the browser
# submitted: the Brick has the client send the amount. See lib/mercadopago.ts.
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# The interactive product tour framed on the landing page. Read at build time, like every
# NEXT_PUBLIC_ variable: set it on the app service and redeploy, not just restart. Left empty the
# demo section renders nothing at all. Copy the id out of the Supademo share modal.
NEXT_PUBLIC_SUPADEMO_DEMO_ID=

# Sending mail, over Resend's HTTP API. Both are required together: with either missing the app
# still takes the address and writes the row, and simply does not send -- a deploy that cannot send
# is not an error at the call site, and local dev runs without them. EMAIL_FROM must be an address on
# a domain verified in Resend, or every send answers 403. In production it is contact@hunch.solutions,
# which is also CONTACT_EMAIL: the reply-to on every message, the footer link and the address the
# privacy policy names. See docs/api.md.
RESEND_API_KEY=
EMAIL_FROM=

# Google Ads conversion upload. Six are required together: googleAdsEnabled() refuses a partial
# set, because half a configuration is one failed upload per payment forever. Unset outside
# production, where the report skips quietly. LOGIN_CUSTOMER_ID is the manager account above the ad
# account and is optional -- leave it out entirely rather than blank, since an empty
# login-customer-id header is refused. Nothing here is served to a browser: there is no gtag.js on
# this site by design. See docs/ads.md.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CONVERSION_ACTION_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# A second conversion action, for a captured address. Deliberately outside the six above: leaving it
# unset has to mean "report payments and nothing else" rather than "report nothing", so the money
# side never goes dark because this was never created. It reports no value, because nobody paid.
# Create it as a SECONDARY action in the account, outside the bidding goal -- as a primary one it
# would point Smart Bidding at people who leave an address and never buy. See docs/ads.md.
GOOGLE_ADS_LEAD_CONVERSION_ACTION_ID=
