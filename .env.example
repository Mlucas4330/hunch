DATABASE_URL=postgres://postgres:postgres@localhost:5432/hunch
AUTH_SECRET=
# Per-environment origins. Never copy these two into a deploy -- a localhost value there breaks
# Google sign in and points shared report links at the visitor's own machine. See README > Deployment.
#
# **AUTH_URL must hold this environment's own origin, in production too.** With it unset, the origin
# comes from the request Next received, which behind a proxy is the container.
#
# **And an empty value is worse than an unset one.** Auth.js resolves trust as
# `AUTH_URL ?? AUTH_TRUST_HOST ?? ...`, and an empty string wins that chain and resolves falsy. Set
# the real origin or remove the variable; never blank it.
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_TRUST_HOST=true

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional second sign in path. The OAuth app needs the `user:email` scope. See docs/security.md.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

BROWSER_URL=

# Where uploaded agency logos are written. A gitignored folder locally; /data/brand on the app's
# volume in production. See docs/deployment.md.
BRAND_DIR=./.brand

# Where the phone screenshot of each measured page is written, on the same volume as the logos:
# /data/screenshots in production. Unset, the report simply shows no picture. See docs/report.md.
SCREENSHOT_DIR=./.screenshots

# Mercado Pago, for the subscription the landing page sells. Unset, the checkout answers 503 and an
# operator still sets quotas by hand. The webhook secret is the one the provider shows when the
# notification URL is registered, and every delivery is refused without it. See docs/api.md.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Where Mercado Pago sends the reader back, when NEXT_PUBLIC_APP_URL is not a URL it will accept.
# It refuses localhost outright, and it refuses some apex domains on newer TLDs: hunch.solutions is
# refused where www.hunch.solutions is accepted. Unset, the app uses its own origin.
BILLING_RETURN_URL=

# Promotes the matching row to admin at sign in, and never demotes. See docs/invariants.md.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Development only: credentialsLoginAllowed() refuses in production whatever this says.
ALLOW_CREDENTIALS_LOGIN=

# Rate limiting AND the job queue. Required: without it every analysis answers 503. See
# docs/development.md.
REDIS_URL=redis://localhost:6379

CSP_ENFORCE=
PUPPETEER_ALLOW_NO_SANDBOX=
ANTHROPIC_API_KEY=
E2E_FIXTURES=

# SE Ranking Data API key (API > Dashboard > Create API key). Without it every analysis is saved with no
# backlink or ranking card and a `seranking.failed` warning in the log. See docs/readout.md.
SE_RANKING_API_KEY=

# Google PageSpeed Insights API key. Without it every analysis is saved with no PageSpeed section and
# a `pagespeed.failed` warning in the log. See docs/readout.md.
PAGESPEED_API_KEY=
