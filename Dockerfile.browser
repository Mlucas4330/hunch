# Chrome, alone. This container holds no DATABASE_URL, no ANTHROPIC_API_KEY and no AUTH_SECRET: its
# entire environment is browser flags. That is deliberate and it is the protection that matters
# here, because the sandbox below is off -- an escaped renderer lands somewhere with nothing to
# steal.
#
# Keep it that way. Railway propagates project-level shared variables into every service, so a
# secret defined at the project level instead of on `app` would end up in this container and undo
# the whole arrangement.
FROM debian:bookworm-slim

# fonts-* is not optional: awaitPaint waits on document.fonts.ready, which resolves in whichever
# process renders the page. A fontless browser returns every screenshot in a fallback face, which is
# exactly the broken-looking preview that wait exists to prevent. Emoji are allowed in product copy.
RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium \
      ca-certificates \
      fonts-liberation \
      fonts-noto-color-emoji \
      dumb-init \
      socat \
  && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 1001 chrome \
  && useradd --system --uid 1001 --gid chrome --create-home chrome

COPY --chmod=0755 scripts/browser-entrypoint.sh /usr/local/bin/browser-entrypoint.sh

USER chrome

# The port socat listens on, not the one Chrome binds. This service must never be given a public
# domain or TCP proxy: anyone who reaches 9222 controls this browser completely, including reading
# files inside this container. The flags, and why a forwarder sits in front, are in the script.
EXPOSE 9222

ENTRYPOINT ["dumb-init", "--", "/usr/local/bin/browser-entrypoint.sh"]
