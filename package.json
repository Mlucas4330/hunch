{
  "name": "hunch",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "tsx --test \"lib/**/*.test.ts\"",
    "preview:screenshot": "tsx --env-file=.env scripts/preview-screenshot.mts",
    "preview:emails": "tsx --env-file=.env scripts/preview-emails.mts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "seed:pulse": "tsx --env-file=.env scripts/seed-pulse.mts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@radix-ui/react-slot": "^1.2.3",
    "ai": "^4.3.16",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.1",
    "drizzle-orm": "^0.44.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.518.0",
    "next": "15.5.19",
    "next-auth": "^5.0.0-beta.29",
    "postgres": "^3.4.7",
    "puppeteer": "^24.10.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stripe": "^18.2.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.1.10",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.15.32",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.29.0",
    "eslint-config-next": "15.5.19",
    "railway": "^3.11.0",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3"
  }
}
