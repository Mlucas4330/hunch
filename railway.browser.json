{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.browser",
    "watchPatterns": ["Dockerfile.browser", "scripts/browser-entrypoint.sh"]
  },
  "deploy": {
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1
  }
}
