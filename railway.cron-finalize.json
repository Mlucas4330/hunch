{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.cron",
    "watchPatterns": ["Dockerfile.cron", "scripts/cron-call.sh"]
  },
  "deploy": {
    "startCommand": "/bin/sh /cron-call.sh /api/cron/finalize-experiments",
    "cronSchedule": "0 8 * * *",
    "restartPolicyType": "NEVER",
    "numReplicas": 1
  }
}
